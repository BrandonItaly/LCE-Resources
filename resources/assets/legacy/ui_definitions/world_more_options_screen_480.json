{
  "targetUI": "wily.legacy.client.screen.WorldMoreOptionsScreen",
  "targetType": "class",
  "applyCondition": {
    "reference": "uiMode.sd"
  },
  "elements": {
    "panel.sprite": {
      "type": "put_resource_location",
      "value": "legacy:tiles/world_more_options_panel"
    },
    "panel.width": {
      "type": "put_number",
      "value": 176
    },
    "tabList.y": {
      "type": "put_number",
      "value": "${panel.y}-18"
    },
    "panel.height": {
      "type": "put_number",
      "value": 156
    },
    "tabList.height": {
      "type": "put_number",
      "value": 20
    },
    "tabList.sprites": {
      "type": "put_toggleable_tab_sprites",
      "value": {
        "high": {
          "left": "legacy:tiles/world_more_options_high_tab_left",
          "middle": "legacy:tiles/world_more_options_high_tab_middle",
          "right": "legacy:tiles/world_more_options_high_tab_right"
        },
        "down": "legacy:tiles/world_more_options_low_tab"
      }
    },
    "tabList.offset": {
      "type": "put_tab_state_offset",
      "value": {
        "selected": [
          0,
          -2
        ],
        "unselected": [
          0,
          2
        ]
      }
    }
  }
}
